


# Node 22.13+ or 24 LTS. Bind is intentionally loopback-only.
PORT=8787
DATA_PATH=data/toolkit.sqlite

# Public snapshots refresh while live trading is paused or wallets are disconnected.
# Default 10 seconds; clamped to 5–60 seconds, plus request time and worker scheduling.
PUBLIC_MARKET_REFRESH_MS=10000

# Set a reliable mainnet Solana RPC for wallet-position reads.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Bybit V5 SOL options. HMAC API credentials stay in this server-only file.
# Use a dedicated Unified Trading Account, Options permissions, and no withdrawals.
# Existing Derive funds are not transferred. Prefund Bybit with USDT yourself.
BYBIT_NETWORK=mainnet
BYBIT_API_KEY=
BYBIT_API_SECRET=
# Stop option execution if the observed USDC/USDT spot basis exceeds this limit.
BYBIT_MAX_STABLECOIN_BASIS_BPS=50
HYPERLIQUID_NETWORK=mainnet

# Keep false during development. Public live market discovery works without this.
ENABLE_LIVE_EXECUTION=false

# Used only to encrypt dedicated generated agent/session keys in the local database.
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# This is NOT your wallet private key. Do not commit it or disclose it.
AGENT_ENCRYPTION_KEY=
